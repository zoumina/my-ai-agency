{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["apps/**/*.ts", "agents/**/*.ts", "core/**/*.ts", "integrations/**/*.ts", "database/**/*.ts", "tests/**/*.ts"]
}